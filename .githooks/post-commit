#!/bin/sh

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
  echo "Self-Learning post-commit deploy skipped: failed to resolve repo root." >&2
  exit 0
fi

DEPLOY_SCRIPT="$REPO_ROOT/deploy_self_learning.ps1"
if [ ! -f "$DEPLOY_SCRIPT" ]; then
  echo "Self-Learning post-commit deploy skipped: deploy_self_learning.ps1 not found." >&2
  exit 0
fi

echo "Self-Learning post-commit: deploying source to AstrBot plugin..."
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$DEPLOY_SCRIPT" -SourceRef HEAD -PreserveExtraFiles
STATUS=$?

if [ "$STATUS" -ne 0 ]; then
  echo "Self-Learning post-commit deploy failed with status $STATUS." >&2
  exit "$STATUS"
fi

echo "Self-Learning post-commit: deploy finished."
exit 0
